<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.impactworks.recall-relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/dantecrescenzi/claudeclaw/relay/dist/recall-relay.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/dantecrescenzi/claudeclaw/relay</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>RELAY_PORT</key>
    <string>7456</string>
    <!-- RELAY_SHARED_SECRET must be set externally; the plist is checked into git
         so we don't put it here. Use `launchctl setenv` before loading, or
         source it from /Users/dantecrescenzi/claudeclaw/relay/.env at boot. -->
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/dantecrescenzi/Library/Logs/claudeclaw-relay/relay.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/dantecrescenzi/Library/Logs/claudeclaw-relay/relay.stderr.log</string>
</dict>
</plist>
